{
  // Cloudflare Workers 설정 — public/ 폴더를 정적 사이트로 배포
  // (AI 자동 분류는 사용자가 늘면 다시 켤 예정: git 기록의 src/index.js 참고)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "test",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
